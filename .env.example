# Mailgun API Key for email notifications
# Find these in your Mailgun Dashboard -> Sending -> API Keys / Domains
MAILGUN_API_KEY=key-xxxxxxxxxxxxxxx
MAILGUN_DOMAIN=sandboxXXXXXXXXXXXX.mailgun.org

# Email configuration
EMAIL_FROM=Free AI Tracker <mailgun@yourmailgundomain>
# Optional: Fallback recipient when there are no subscribers (used until someone
# signs up via the dashboard). Once subscribers exist, each subscriber gets the digest.
# Note: Mailgun sandbox can only send to up to 5 authorized recipients (add them in
# Mailgun Dashboard -> the sandbox domain -> Setup tab).
EMAIL_TO=your-email@example.com

# Upstash Redis (replaces deprecated Vercel KV)
# Find these in your Upstash console -> REST API
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# Optional: GitHub token to raise search rate limits (60 -> 5000 req/hr)
GITHUB_TOKEN=

# Optional: Log level (debug, info, warn, error)
LOG_LEVEL=info