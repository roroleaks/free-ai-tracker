# Resend API Key for email notifications
RESEND_API_KEY=re_xxxxxxxxxxxxx

# Email configuration
EMAIL_FROM=Free AI Tracker <tracker@yourdomain.com>
# Optional: Fallback recipient when there are no subscribers (used until someone
# signs up via the dashboard). Once subscribers exist, each subscriber gets the digest.
EMAIL_TO=your-email@example.com

# Upstash Redis (replaces deprecated Vercel KV)
# Find these in your Upstash console -> REST API
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# Optional: GitHub token to raise search rate limits (60 -> 5000 req/hr)
GITHUB_TOKEN=

# Optional: Log level (debug, info, warn, error)
LOG_LEVEL=info