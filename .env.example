# Brevo (formerly Sendinblue) API Key for email notifications
# Free: 300 emails/day, no credit card, no custom domain needed.
# Get it: Brevo dashboard -> SMTP & API -> API Keys -> Generate new API key
BREVO_API_KEY=xkeysib-xxxxxxxxxxxx

# Email configuration
# The From address must be a sender you've verified in Brevo:
# dashboard -> Senders & IPs -> Senders -> Add a sender. It can be any email
# you own (works without a custom domain).
EMAIL_FROM=Free AI Tracker <you@example.com>
# Optional: Fallback recipient when there are no subscribers (used until someone
# signs up via the dashboard). Once subscribers exist, each subscriber gets the digest.
EMAIL_TO=your-email@example.com

# Upstash Redis (replaces deprecated Vercel KV)
# Find these in your Upstash console -> REST API
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# Optional: GitHub token to raise search rate limits (60 -> 5000 req/hr)
GITHUB_TOKEN=

# Optional: Reddit app (script type) credentials for r/ChatGPT, r/LocalLLaMA etc.
# Without these the tracker falls back to Reddit's public RSS feed (best-effort,
# frequently rate-limited, so some subreddits may be missing).
# Get them: reddit.com/prefs/apps -> Create another app -> script.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Optional: Log level (debug, info, warn, error)
LOG_LEVEL=info